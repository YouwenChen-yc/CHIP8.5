<h2>Search in TMDb</h2>

<div class="search-container mb-4">
  <%= form_tag search_tmdb_path, method: :post, id: 'tmdb_form' do %>
    <div class="form-group">
      <label for="movie_title_field">Movie Name</label>
      <%= text_field_tag 'title', nil, class: "form-control", id: "movie_title_field", placeholder: "Manhunter" %> 
    </div>

    <div class="form-group">
      <label for="movie_year_field">Release Year</label>
      <%= text_field_tag 'release_year', nil, class: "form-control", id: "movie_year_field", placeholder: "1986" %>
    </div>
    
    <div class="form-check mt-2">
      <%= radio_button_tag 'language', 'en', false, class: "form-check-input", id: "language_en" %>
      <label class="form-check-label" for="language_en">English Only</label>
    </div>

    <div class="form-check mb-3">
      <%= radio_button_tag 'language', 'all', true, class: "form-check-input", id: "language_all" %>
      <label class="form-check-label" for="language_all">All Languages</label>
    </div>
    
    <%= submit_tag 'Search', id: 'tmdb_submit', class: 'btn btn-warning' %>
    <%= link_to 'Back to movie list', movies_path, class: 'btn btn-secondary' %>
  <% end %>
</div>

<% if @movies.present? %>
  <h3>Search Results</h3>
  <table class="table table-striped col-md-12" id="search_movies">
    <thead>
      <tr>
        <th>Movie Title</th>
        <th>Rating</th>
        <th>Release Date</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date %></td>
          <td>
            <%= form_tag add_movie_path, method: :post do %>
              <%= hidden_field_tag 'movie[title]', movie.title %>
              <%= hidden_field_tag 'movie[rating]', movie.rating %>
              <%= hidden_field_tag 'movie[description]', movie.description %>
              <%= hidden_field_tag 'movie[release_date]', movie.release_date %>
              <%= submit_tag 'Add movie', class: 'btn btn-primary' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>